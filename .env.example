# ---------------------------------------------------------------------------
# Contact form delivery (POST /api/contact → email via SMTP)
#
# Copy to .env.local (or set in the hosting platform's environment settings).
# All values are server-side only: none of them use the NEXT_PUBLIC_ prefix,
# so they are never sent to the browser. Never commit real values.
#
# Until SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASSWORD are all set, the
# form does not claim to send anything: it tells the visitor that online
# sending is unavailable and offers a pre-filled email to info@nknmedia.in.
# ---------------------------------------------------------------------------

# Required — the outgoing mail server of the mailbox that will send the form
SMTP_HOST=
# Required — usually 465 (implicit TLS) or 587 (STARTTLS)
SMTP_PORT=
# Required — SMTP login
SMTP_USER=
# Required — SMTP password or app password
SMTP_PASSWORD=

# Optional — "true" for implicit TLS. Default: true when SMTP_PORT is 465, otherwise false
SMTP_SECURE=
# Optional — on non-TLS ports the connection must upgrade with STARTTLS.
# Set to "false" only for a trusted relay without TLS. Default: true
SMTP_REQUIRE_TLS=

# Optional — address the form emails are sent from; it must be allowed to
# send through the SMTP account. Default: SMTP_USER
CONTACT_FROM_EMAIL=
# Optional — where submissions are delivered. Default: info@nknmedia.in
# (the address published on spiceroutemagazine.in and in the magazine imprint)
CONTACT_TO_EMAIL=
